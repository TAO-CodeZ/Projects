<Window x:Class="Insurance.LecturerDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lecturer Dashboard" Height="460" Width="760"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#ffffff" Margin="12">
        <StackPanel>
            <TextBlock Text="Submit New Claim" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
            <WrapPanel Margin="0,0,0,10">
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Subject:"/>
                    <TextBox x:Name="SubjectTextBox" Width="260" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Hours:"/>
                    <TextBox x:Name="HoursTextBox" Width="120" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Rate (R):"/>
                    <TextBox x:Name="RateTextBox" Width="120" Margin="0,4,0,0"/>
                </StackPanel>
            </WrapPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Submit Claim" Width="140" Height="36" Click="Submit_Click" Margin="0,0,12,0"/>
                <Button Content="Back to Menu" Width="140" Height="36" Click="Back_Click"/>
            </StackPanel>

            <TextBlock Text="Your Submitted Claims" FontWeight="Bold" Margin="0,6,0,6"/>
            <DataGrid x:Name="ClaimsGrid" AutoGenerateColumns="False" Height="250" IsReadOnly="True" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Claim ID" Binding="{Binding ClaimID}" Width="90"/>
                    <DataGridTextColumn Header="Lecturer Name" Binding="{Binding LecturerName}" Width="*"/>
                    <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="*"/>
                    <DataGridTextColumn Header="Hours" Binding="{Binding Hours}" Width="80"/>
                    <DataGridTextColumn Header="Rate" Binding="{Binding Rate}" Width="100"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="100"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</Window>
