<Window x:Class="Insurance.AcademicManager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Academic Manager" Height="520" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#ffffff" Margin="12">
        <StackPanel>
            <TextBlock Text="Academic Manager Review" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
            <DataGrid x:Name="ManagerGrid" AutoGenerateColumns="False" Height="340" IsReadOnly="True" CanUserAddRows="False" Margin="0,0,0,8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Claim ID" Binding="{Binding ClaimID}" Width="90"/>
                    <DataGridTextColumn Header="Lecturer Name" Binding="{Binding LecturerName}" Width="*"/>
                    <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="*"/>
                    <DataGridTextColumn Header="Hours" Binding="{Binding Hours}" Width="80"/>
                    <DataGridTextColumn Header="Rate" Binding="{Binding Rate}" Width="100"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="100"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Approve" Width="140" Height="36" Margin="6" Click="Approve_Click"/>
                <Button Content="Reject" Width="140" Height="36" Margin="6" Click="Reject_Click"/>
                <Button Content="Back to Menu" Width="140" Height="36" Margin="6" Click="Back_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
