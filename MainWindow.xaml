<Window x:Class="Insurance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Insurance - CMCS Navigation"
        Height="320" Width="420"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#f2f2f2">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Insurance - CMCS Prototype" FontSize="20" FontWeight="Bold" Margin="0,0,0,18" TextAlignment="Center"/>
            <Button Content="Lecturer Dashboard" Width="240" Height="36" Margin="0,0,0,10" Click="Lecturer_Click"/>
            <Button Content="Programme Coordinator" Width="240" Height="36" Margin="0,0,0,10" Click="Coordinator_Click"/>
            <Button Content="Academic Manager" Width="240" Height="36" Click="Manager_Click"/>
        </StackPanel>
    </Grid>
</Window>
